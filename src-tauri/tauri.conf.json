{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JobHQ",
  "version": "0.1.0",
  "identifier": "com.jobhq.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev -- --desktop",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JobHQ",
        "width": 1360,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "visible": false,
        "devtools": true,
        "backgroundColor": "#f6f5f2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist_backend/jobhq-backend": "jobhq-backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
